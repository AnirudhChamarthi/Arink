<UserControl x:Class="Riskbot.App.Views.ResultPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{StaticResource SurfaceBackground}"
            BorderBrush="{StaticResource BorderBrushDark}"
            BorderThickness="1"
            Padding="14,10"
            Margin="0,0,0,6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderBrushDark}"
                    BorderThickness="0,0,0,1"
                    Padding="0,0,0,8"
                    Margin="0,0,0,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding ToplineNumber}"
                               FontSize="40"
                               FontWeight="Bold"
                               FontFamily="{StaticResource MonoFont}"
                               Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding StatusMessage}"
                               Foreground="{StaticResource TextSecondary}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="320"
                               TextAlignment="Right"/>
                </DockPanel>
            </Border>

            <TextBlock Grid.Row="1"
                       Text="{Binding ToplineLabel}"
                       Foreground="{StaticResource TextPrimary}"
                       FontWeight="SemiBold"
                       FontSize="12"
                       Margin="0,0,0,8"/>

            <Expander Grid.Row="2"
                      Header="FORMULA BREAKDOWN"
                      Margin="0,0,0,8"
                      IsExpanded="{Binding IsFormulaExpanded, Mode=TwoWay}"
                      Foreground="{StaticResource AccentBrush}"
                      FontWeight="SemiBold"
                      FontSize="11">
                <ItemsControl ItemsSource="{Binding FormulaLines}" Margin="8,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>

            <DockPanel Grid.Row="3" MinHeight="48">
                <Button DockPanel.Dock="Right"
                        Content="OPEN EXCEL ↗"
                        Style="{StaticResource AccentButton}"
                        Margin="12,0,0,0"
                        Padding="14,8"
                        Command="{Binding OpenExcelReportCommand}"
                        Visibility="{Binding CanOpenExcelReport, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding Explanation}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="13"
                           LineHeight="22"/>
            </DockPanel>

            <Border Grid.Row="0" Grid.RowSpan="4"
                    Background="#CC050810"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="RUNNING QUERY…"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource MonoFont}"
                           FontWeight="Bold"
                           FontSize="14"
                           Foreground="{StaticResource AccentBrush}"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
