<Window x:Class="Riskbot.App.Views.ApiKeySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anthropic API Key"
        Height="440" Width="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource ShellBackground}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource PanelHeader}" Text="API KEY" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="1"
                   Text="Claude API key for NLQ routing and explanations"
                   Foreground="{StaticResource TextPrimary}"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"/>

        <TextBlock Grid.Row="2"
                   Foreground="{StaticResource TextSecondary}"
                   TextWrapping="Wrap"
                   FontSize="12"
                   Margin="0,0,0,8"
                   Text="{Binding GitNotice}"/>

        <TextBlock Grid.Row="3"
                   Style="{StaticResource HintText}"
                   Text="{Binding EnvFilePath, StringFormat=File: {0}}"
                   Margin="0,0,0,10"/>

        <StackPanel Grid.Row="4">
            <PasswordBox x:Name="KeyBoxHidden" Height="32" Padding="8,0"
                         PasswordChanged="OnPasswordChanged"/>
            <TextBox x:Name="KeyBoxVisible" Height="32" Padding="8,0" Visibility="Collapsed"
                     FontFamily="{StaticResource MonoFont}"
                     Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"/>
            <CheckBox x:Name="ShowKeyCheck" Margin="0,10,0,0" Content="Show key"
                      IsChecked="{Binding ShowKey}"
                      Checked="OnShowKeyChanged" Unchecked="OnShowKeyChanged"/>
            <TextBlock Margin="0,12,0,0"
                       Foreground="{StaticResource AccentSecondary}"
                       Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       FontSize="12"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Clear key" Width="90" Margin="0,0,8,0" Command="{Binding ClearKeyCommand}"/>
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" IsCancel="True" Click="OnCancelClick"/>
            <Button Content="Save" Width="80" Style="{StaticResource AccentButton}" IsDefault="True"
                    Command="{Binding SaveCommand}"/>
        </StackPanel>
    </Grid>
</Window>
