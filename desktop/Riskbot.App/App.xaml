<Application x:Class="Riskbot.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Blue / black terminal palette -->
        <Color x:Key="BbBlack">#FF000000</Color>
        <Color x:Key="BbPanel">#FF0A0A0C</Color>
        <Color x:Key="BbSurface">#FF101018</Color>
        <Color x:Key="BbGrid">#FF161622</Color>
        <Color x:Key="BbBorder">#FF2A3040</Color>
        <Color x:Key="BbBlue">#FF2D7DD2</Color>
        <Color x:Key="BbBlueBright">#FF4DA3FF</Color>
        <Color x:Key="BbBlueDeep">#FF0D2137</Color>
        <Color x:Key="BbBlueBar">#FF102A43</Color>
        <Color x:Key="BbText">#FFE8ECF4</Color>
        <Color x:Key="BbTextDim">#FF9AA8C4</Color>
        <Color x:Key="BbTextMuted">#FF5C6B82</Color>
        <Color x:Key="BbGreen">#FF4ADE80</Color>
        <Color x:Key="BbRed">#FFFF6B6B</Color>
        <Color x:Key="BbRowAlt">#FF12121A</Color>
        <Color x:Key="BbRowHover">#FF1C2438</Color>
        <Color x:Key="BbRowSelect">#FF152A4A</Color>

        <SolidColorBrush x:Key="ShellBackground" Color="{StaticResource BbBlack}"/>
        <SolidColorBrush x:Key="PanelBackground" Color="{StaticResource BbPanel}"/>
        <SolidColorBrush x:Key="SurfaceBackground" Color="{StaticResource BbSurface}"/>
        <SolidColorBrush x:Key="GridBackground" Color="{StaticResource BbGrid}"/>
        <SolidColorBrush x:Key="BorderBrushDark" Color="{StaticResource BbBorder}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource BbBlue}"/>
        <SolidColorBrush x:Key="AccentSecondary" Color="{StaticResource BbBlueBright}"/>
        <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource BbText}"/>
        <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource BbTextDim}"/>
        <SolidColorBrush x:Key="TextMuted" Color="{StaticResource BbTextMuted}"/>
        <SolidColorBrush x:Key="PositiveBrush" Color="{StaticResource BbGreen}"/>
        <SolidColorBrush x:Key="NegativeBrush" Color="{StaticResource BbRed}"/>
        <SolidColorBrush x:Key="StatusBarBackground" Color="{StaticResource BbBlueBar}"/>
        <SolidColorBrush x:Key="StatusBarForeground" Color="{StaticResource BbText}"/>
        <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="RowAltBrush" Color="{StaticResource BbRowAlt}"/>
        <SolidColorBrush x:Key="RowHoverBrush" Color="{StaticResource BbRowHover}"/>
        <SolidColorBrush x:Key="RowSelectBrush" Color="{StaticResource BbRowSelect}"/>

        <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
        <FontFamily x:Key="MonoFont">Consolas</FontFamily>

        <!-- Window -->
        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource ShellBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Menu -->
        <Style TargetType="Menu">
            <Setter Property="Background" Value="{StaticResource PanelBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="{StaticResource PanelBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{StaticResource GridBackground}"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                </Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter Property="Background" Value="{StaticResource GridBackground}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Background" Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="Margin" Value="4,2"/>
        </Style>

        <!-- Buttons -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource GridBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource GridBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="SelectionBrush" Value="#442D7DD2"/>
        </Style>

        <!-- PasswordBox -->
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource GridBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
        </Style>

        <!-- ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource GridBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource PanelBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{StaticResource RowSelectBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <!-- Expander -->
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- ScrollBar (dark) -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="{StaticResource PanelBackground}"/>
        </Style>

        <!-- DataGrid global -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource GridBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="{StaticResource GridBackground}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource RowAltBrush}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource PanelBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource RowSelectBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentSecondary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource RowSelectBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBlock default in dark app -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <!-- Accent primary button -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextOnAccent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentSecondary}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextOnAccent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PanelHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Application.Resources>
</Application>
