      "type": "string"
    },
    "SensitivityRow": {
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "title": "Dimension",
          "type": "string"
        },
        "effect": {
          "description": "max(medians) - min(medians).",
          "title": "Effect",
          "type": "number"
        },
        "medians": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "Dimension value (as string) -> median of the metric.",
          "title": "Medians",
          "type": "object"
        },
        "metric": {
          "title": "Metric",
          "type": "string"
        }
      },
      "required": [
        "dimension",
        "metric",
        "medians",
        "effect"
      ],
