          "default": null,
          "title": "Trace Id"
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "name",
        "value",
        "unit",
        "found",
        "description"
      ],
      "title": "BreakEven",
      "type": "object"
    },
