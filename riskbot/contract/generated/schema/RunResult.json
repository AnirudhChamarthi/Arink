          "type": "string"
        },
        "matched": {
          "title": "Matched",
          "type": "boolean"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "location",
        "text",
        "value",
        "matched",
        "message"
      ],
      "title": "VerifierFinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
