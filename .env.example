# Riskbot environment configuration
#
# Setup:
#   1. Open Riskbot → Help → API Key Settings… (creates .env automatically if missing)
#   2. Or copy this file to `.env` in the same folder (repo root).
#   3. Fill in the values below.
#
# `.env` is gitignored — do not commit real API keys.

# Claude — NLQ query routing and result explanations (Step 6).
# Get a key at https://console.anthropic.com/
# Leave blank to use built-in keyword routing (no Claude calls).
ANTHROPIC_API_KEY=

# Optional Claude model id (default: claude-sonnet-4-6). See https://platform.claude.com/docs/en/about-claude/models/overview
# ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenFigi — optional ISIN → ticker lookup during enrichment.
# OPENFIGI_API_KEY=

# Python executable used when the desktop app spawns the engine (default: python on PATH).
# RISKBOT_PYTHON=python
